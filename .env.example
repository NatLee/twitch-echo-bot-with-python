# Copy this file to .env and fill it in: cp .env.example .env
# .env is listed in .gitignore. Never commit a real token.
# How to get a token and which scopes it needs: README, "Get a token".

# The channel to join: a Twitch login name, without the #
TWITCH_CHANNEL=your_channel

# The bot account's login name. It must be the account the token belongs to.
TWITCH_BOT_NAME=your_bot_account

# A user access token of the bot account, with or without "oauth:" in front.
# Scopes: chat:read chat:edit (main.py and examples/irc_library_echo.py)
#         user:read:chat user:write:chat (examples/eventsub_echo.py)
TWITCH_OAUTH_TOKEN=

# Optional. Leave these out to use the real Twitch chat (irc.chat.twitch.tv:6697 with TLS).
# For the practice server (python tools/fake_twitch_server.py) use:
# TWITCH_IRC_HOST=127.0.0.1
# TWITCH_IRC_PORT=6667
# TWITCH_IRC_TLS=false
